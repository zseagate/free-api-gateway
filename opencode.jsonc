{
  "$schema": "https://opencode.ai/config.json",
  "model": "gw/deepseek/deepseek-v4.1-flash:free",
  "providers": {
    "gw": {
      "name": "Free Gateway (new-api)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:3001/v1",
        "apiKey": "{env:NEW_API_TOKEN}"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash:free": {
          "modelID": "deepseek/deepseek-v4.1-flash:free",
          "name": "DeepSeek V4.1 Flash (Numes free)",
          "settings": {
            "reasoningEffort": "high"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 4096
          }
        },
