# ============================================================
# 复制为 .env 并填入真实值: cp .env.example .env
# 此文件只含你本机的第三方免费档 Key，勿提交、勿外传
# ============================================================

# ---- 上游免费档 Key（去各控制台申请）----
# Numes      https://numes.ai  (API keys 页面创建, sk-numes-v1- 开头)
NUMES_API_KEY=sk-numes-v1-REPLACE_ME

# OpenRouter https://openrouter.ai/keys  (sk-or-v1- 开头)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Groq       https://console.groq.com/keys  (gsk_ 开头)
GROQ_API_KEY=gsk_xxx-REPLACE_ME

# ---- 同步行为（充值前/后两套场景，按需切换）----
# 场景 A 充值前（免费额度紧张）：SYNC_MAX_TEST=12、SYNC_TEST_SLEEP=1
# 场景 B 充值后（无限流）：留空 SYNC_MAX_TEST、设 SYNC_TEST_SLEEP=0
# 留空即视为不限制 / 使用默认 1 秒
SYNC_MAX_TEST=12
SYNC_TEST_SLEEP=1

# ---- new-api 网关/控制台 ----
NEW_API_BASE_URL=http://127.0.0.1:3000
# Groq 提示词截断代理（可选，控制 Groq 免费档 ITPM）
PROXY_BASE_URL=http://127.0.0.1:3001
# 控制台创建后填入（OpenCode 用这个作为 provider key）
NEW_API_TOKEN=sk-xxxxx-REPLACE_ME
