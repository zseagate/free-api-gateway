# Free API 环境配置示例 — 复制为 .env 并填入真实值: cp .env.example .env
# 真实 Key 只放 .env (被 .gitignore 忽略), 绝不提交。此文件只含占位符。

# ===== 直连 Numes (方案一, 简单) =====
# Numes inference API Key (sk- 开头), 在 https://numes.ai 的 API keys 页面创建
NUMES_API_KEY=sk-numes-v1-REPLACE_ME

# Numes OpenAI 兼容 Base URL (通常无需修改)
NUMES_BASE_URL=https://api.numes.ai/api/v1

# ===== free-api-gateway (new-api 自托管网关, 方案二, 推荐聚合) =====
# 上游免费档 Key (各渠道控制台申请)
# Numes      https://numes.ai          (sk-numes-v1- 开头)
# OpenRouter https://openrouter.ai/keys (sk-or-v1- 开头)
# Groq       https://console.groq.com/keys (gsk_ 开头)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
GROQ_API_KEY=gsk_xxx-REPLACE_ME

# 同步行为 (充值前/后两套场景, 按需切换)
# 场景 A 充值前 (免费额度紧张): SYNC_MAX_TEST=12、SYNC_TEST_SLEEP=1
# 场景 B 充值后 (无限流): 留空 SYNC_MAX_TEST、设 SYNC_TEST_SLEEP=0
# 留空即视为不限制 / 使用默认 1 秒
SYNC_MAX_TEST=12
SYNC_TEST_SLEEP=1

# new-api 网关/控制台 (控制台地址)
NEW_API_BASE_URL=http://127.0.0.1:3000
# Groq 提示词截断代理 (可选, 监听 3001, 转发到 3000)。
# 用代理时 opencode-gateway.jsonc 的 baseURL 保持 3001; 不用则改成 3000。
PROXY_BASE_URL=http://127.0.0.1:3001
# 控制台「令牌」页创建后填入 (OpenCode 用这个作为 provider key)
NEW_API_TOKEN=sk-xxxxx-REPLACE_ME
